# QuantaBench Backend Configuration

# Environment
ENV=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Classiq Authentication
# Get your credentials from https://platform.classiq.io/
CLASSIQ_CLIENT_ID=your_client_id_here
CLASSIQ_CLIENT_SECRET=your_client_secret_here
# OR use interactive authentication (leave above blank)

# qBraid Authentication
# Get your API key from https://account.qbraid.com/account/api-keys
QBRAID_API_KEY=your_qbraid_api_key_here

# IonQ (if using self-managed)
IONQ_API_KEY=your_ionq_api_key_here

# Feature Flags
ENABLE_CLASSIQ=true
ENABLE_QBRAID=true
ENABLE_HARDWARE=false
CACHE_ENABLED=true

# Optimization Settings
DEFAULT_QAOA_P=2
MAX_QAOA_P=3
DEFAULT_SHOTS=1024
MAX_OPTIMIZER_RESTARTS=3

# Cache Settings
CACHE_DIR=.cache
CACHE_TTL_HOURS=168  # 1 week
